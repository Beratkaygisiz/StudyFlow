@{
    ViewData["Title"] = "Hakkında";
}

<!-- ÜST VİZYON BANNER (7 Slaytlık Sunum Hikayesi ile Uyumlu) -->
<section class="ocsts-hero p-4 p-lg-5 mb-4">
    <div class="ocsts-hero-pill mb-3">
        <i class="bi bi-layers-fill text-info"></i>
        <span>Proje Vizyonu & Teknik Mimari • Kısım 1 + Kısım 2</span>
    </div>
    <h1 class="fw-extrabold mb-2">@ViewBag.ProjectName</h1>
    <p class="lead mb-0" style="color: rgba(255,255,255,0.86); max-width: 780px;">
        @ViewBag.Subtitle Üniversite öğrencilerinin sınav tarihlerini, hedef notlarını ve ders çalışma süreçlerini tek bir merkezden düzenli biçimde yönetebilmeleri için <strong>ASP.NET Core MVC</strong> mimarisiyle geliştirilmiş büyümeye açık bir web uygulamasıdır.
    </p>
</section>

@* ============================================================================
   [KISIM 2 İSTERİ] - VIEWCOMPONENT ÇAĞRISI (Senaryo 4: Hakkında Sayfası Canlı Özet)
   ============================================================================ *@
@await Component.InvokeAsync("AcademicSummary", new { mode = "compact" })

<!-- SLAYT 02 & 03: PROBLEM, İHTİYAÇ VE PROJENİN AMACI -->
<div class="row g-4 mb-4">
    <div class="col-lg-6">
        <div class="card border-0 h-100">
            <div class="card-body p-4">
                <span class="badge bg-danger-subtle text-danger-emphasis mb-2">Problem ve İhtiyaç</span>
                <h4 class="fw-bold mb-3">Öğrenciler sınav dönemlerinde neden zorlanıyor?</h4>

                <div class="d-flex gap-3 mb-3">
                    <span class="ocsts-step-num">01</span>
                    <div>
                        <h6 class="fw-bold mb-1">Dağınık Bilgiler</h6>
                        <p class="text-muted small mb-0">Sınav tarihleri, konular ve hedefler defter, telefon ve mesajlar arasında dağınık kalır.</p>
                    </div>
                </div>
                <div class="d-flex gap-3 mb-3">
                    <span class="ocsts-step-num">02</span>
                    <div>
                        <h6 class="fw-bold mb-1">Takip Güçlüğü</h6>
                        <p class="text-muted small mb-0">Hangi derse ne kadar çalışıldığı ve hangi konunun eksik kaldığı zamanla karışır.</p>
                    </div>
                </div>
                <div class="d-flex gap-3">
                    <span class="ocsts-step-num">03</span>
                    <div>
                        <h6 class="fw-bold mb-1">Görünürlük Eksikliği</h6>
                        <p class="text-muted small mb-0">Tamamlanan ve bekleyen çalışmalar tek bir ekranda net biçimde görülemez.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-6">
        <div class="card border-0 h-100">
            <div class="card-body p-4">
                <span class="badge bg-success-subtle text-success-emphasis mb-2">Hedef Kullanıcı & Örnek Akış</span>
                <h4 class="fw-bold mb-3">Bireysel Üniversite Öğrencisi Senaryosu</h4>
                <p class="text-muted small mb-3">
                    Çok sayıda ders ve sınavı aynı dönemde yönetmek isteyen öğrenciler için uçtan uca kullanım senaryosu:
                </p>

                <div class="ocsts-item-card p-3 rounded-3 mb-2">
                    <div class="fw-semibold small"><i class="bi bi-1-circle-fill text-primary me-2"></i>Sınav ve Hedef Kaydı</div>
                    <div class="text-muted small mt-1">Öğrenci yaklaşan <strong>Web Programlama</strong> sınavını sisteme ekler ve hedef not olarak <strong>90 puan</strong> belirler.</div>
                </div>
                <div class="ocsts-item-card p-3 rounded-3 mb-2">
                    <div class="fw-semibold small"><i class="bi bi-2-circle-fill text-primary me-2"></i>Çalışma Konularının Planlanması</div>
                    <div class="text-muted small mt-1">Sınav için çalışması gereken <strong>MVC, ViewComponent ve Razor</strong> konularını saat hedefleriyle çalışma planına kaydeder.</div>
                </div>
                <div class="ocsts-item-card p-3 rounded-3">
                    <div class="fw-semibold small"><i class="bi bi-3-circle-fill text-success me-2"></i>İlerleme ve Not Takibi</div>
                    <div class="text-muted small mt-1">Çalıştığı saatleri girdikçe konular otomatik <strong>Tamamlandı</strong> olarak işaretlenir; sınav sonrası gerçek notunu kaydeder.</div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- SLAYT 05: TEMEL MODÜLLER -->
<div class="row g-4 mb-4">
    <div class="col-md-6">
        <div class="card border-0 h-100">
            <div class="card-body p-4">
                <div class="d-flex align-items-center gap-3 mb-3">
                    <div class="ocsts-icon-box bg-primary bg-opacity-10 text-primary">
                        <i class="bi bi-calendar2-check-fill"></i>
                    </div>
                    <div>
                        <span class="badge ocsts-badge-soft-primary">Modül 01</span>
                        <h5 class="fw-bold mb-0">Sınav Yönetimi (Exam)</h5>
                    </div>
                </div>
                <ul class="small text-muted mb-0 ps-3">
                    <li class="mb-1">Ders adı, sınav türü (Vize/Final/Quiz/Proje), sınav tarihi ve hedef not kaydı</li>
                    <li class="mb-1">Yaklaşan sınavlar için kalan gün sayacı</li>
                    <li class="mb-1">Tarihi geçen sınavlar için <strong>"Sınav Notu Gir"</strong> penceresi ve hedef karşılaştırması</li>
                </ul>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card border-0 h-100">
            <div class="card-body p-4">
                <div class="d-flex align-items-center gap-3 mb-3">
                    <div class="ocsts-icon-box bg-success bg-opacity-10 text-success">
                        <i class="bi bi-list-task"></i>
                    </div>
                    <div>
                        <span class="badge bg-success-subtle text-success-emphasis">Modül 02</span>
                        <h5 class="fw-bold mb-0">Çalışma Planı (StudyPlan)</h5>
                    </div>
                </div>
                <ul class="small text-muted mb-0 ps-3">
                    <li class="mb-1">Ders adı, konu başlığı, öncelik düzeyi ve hedeflenen çalışma süresi kaydı</li>
                    <li class="mb-1">Tablo üzerinden doğrudan çalışılan saat güncelleme</li>
                    <li class="mb-1">Hedef süreye ulaşıldığında otomatik <strong>"Tamamlandı"</strong> durum geçişi ve ilerleme çubuğu</li>
                </ul>
            </div>
        </div>
    </div>
</div>

<!-- KISIM 2 YENİ MİMARİ İSTERLER VE TEKNİK ALTYAPI -->
<div class="card border-0 mb-2">
    <div class="card-body p-4 p-lg-5">
        <div class="mb-4">
            <span class="badge ocsts-badge-soft-primary mb-2">Kısım 2 • Yeni Eklenen Mimari Yapılar</span>
            <h4 class="fw-bold mb-1">Teknik Altyapı ve Kısım 2 Güncellemeleri</h4>
            <p class="text-muted small mb-0">
                Temel MVC iskeletinin (3 Controller, 6 Ana View, Razor döngüleri ve JSON kalıcılığı) üzerine Kısım 2 isterleri doğrultusunda eklenen bileşenler:
            </p>
        </div>

        <div class="row g-3">
            <div class="col-md-6">
                <div class="ocsts-item-card p-3 rounded-3 h-100">
                    <h6 class="fw-bold text-primary mb-2">
                        <i class="bi bi-boxes me-1"></i>1. ViewComponent Kullanımı
                    </h6>
                    <p class="small text-muted mb-0">
                        <code>AcademicSummaryViewComponent</code> kendi bağımsız C# <code>Invoke()</code> mantığıyla sınav ve çalışma verilerini analiz eder. <strong>Ana Sayfa</strong> (tam özet), <strong>Sınav Yönetimi</strong> (sınav KPI), <strong>Çalışma Planı</strong> (süre ilerlemesi) ve <strong>Hakkında</strong> (kompakt durum) olmak üzere 4 farklı sayfada senaryoya uygun modlarda gösterilir.
                    </p>
                </div>
            </div>

            <div class="col-md-6">
                <div class="ocsts-item-card p-3 rounded-3 h-100">
                    <h6 class="fw-bold text-primary mb-2">
                        <i class="bi bi-puzzle-fill me-1"></i>2. PartialView Kullanımı
                    </h6>
                    <p class="small text-muted mb-0">
                        <code>_ExamCardPartial</code> ve <code>_StudyPlanCardPartial</code> bileşenleri hem <strong>Ana Sayfa</strong> vitrininde hem de <strong>Yeni Sınav / Konu Ekle</strong> sayfalarının sağ önizleme panellerinde tekrar kullanılarak kod tekrarını önler. <code>_AlertMessagePartial</code> ise sayfalar arası işlem bildirimlerini gösterir.
                    </p>
                </div>
            </div>

            <div class="col-md-6">
                <div class="ocsts-item-card p-3 rounded-3 h-100">
                    <h6 class="fw-bold text-primary mb-2">
                        <i class="bi bi-input-cursor-text me-1"></i>3. HtmlHelpers & Sayfalar Arası Veri Akışı
                    </h6>
                    <p class="small text-muted mb-0">
                        Tüm veri giriş formları <code>Html.BeginForm</code>, <code>Html.LabelFor</code>, <code>Html.TextBoxFor</code>, <code>Html.DropDownListFor</code>, <code>Html.TextAreaFor</code> ve <code>Html.CheckBoxFor</code> ile oluşturulmuştur. Ekleme sayfasından girilen her kayıt, <strong>Listeleme</strong> sayfalarında ve <strong>Ana Sayfa</strong> üzerinde anında görüntülenir.
                    </p>
                </div>
            </div>

            <div class="col-md-6">
                <div class="ocsts-item-card p-3 rounded-3 h-100">
                    <h6 class="fw-bold text-primary mb-2">
                        <i class="bi bi-palette2 me-1"></i>4. Modernize Edilmiş Arayüz & Koyu Mod
                    </h6>
                    <p class="small text-muted mb-0">
                        CSS değişkenleri (Custom Properties), Plus Jakarta Sans tipografisi, cam efektli (glassmorphism) üst menü, görsel ilerleme çubukları ve tam uyumlu <strong>Açık / Koyu Mod</strong> desteği ile kullanıcı deneyimi daha anlaşılır ve modern hale getirilmiştir.
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>
