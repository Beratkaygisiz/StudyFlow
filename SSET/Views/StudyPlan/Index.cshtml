@*
    ÇALIŞMA PLANI LİSTELEME SAYFASI:
    Controller'dan gelen List<StudyPlan> modelini dinamik olarak listeler.
*@
@model List<SSET.Models.StudyPlan>

@{
    ViewData["Title"] = "Çalışma Planı";
}

<!-- Başlık ve Yeni Ekleme Butonu -->
<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="fw-bold text-dark mb-0">
        <i class="bi bi-calendar-check text-success me-2"></i>Ders Çalışma Planı
    </h3>
    <a asp-controller="StudyPlan" asp-action="Create" class="btn btn-success">
        <i class="bi bi-plus-circle me-1"></i> + Yeni Konu Ekle
    </a>
</div>

<!-- ========================================================================== -->
<!-- KART İÇİNDE DİNAMİK RAZOR TABLOSU                                         -->
<!-- ========================================================================== -->
<div class="card shadow-sm border-0">
    <div class="card-header bg-white fw-bold text-secondary">
        Haftalık Çalışma Konuları (Toplam: @Model.Count)
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th style="width: 50px;">#</th>
                        <th>Ders Adı</th>
                        <th>Çalışılacak Konu</th>
                        <th>Hedef Süre</th>
                        <th>Durum</th>
                    </tr>
                </thead>
                <tbody>
                    @* 
                        RAZOR DİNAMİK FOREACH DÖNGÜSÜ:
                        Controller'daki konuları tek tek tablo satırına dönüştürür.
                    *@
                    @foreach (var plan in Model)
                    {
                        <tr>
                            <td class="fw-bold text-muted">@plan.Id</td>
                            <td><span class="badge bg-light text-dark border">@plan.CourseName</span></td>
                            <td><strong>@plan.TopicTitle</strong></td>
                            <td>@plan.PlannedHours Saat</td>
                            <td>
                                @if (plan.IsCompleted)
                                {
                                    <span class="badge bg-success">Tamamlandı</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning text-dark">Devam Ediyor</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
