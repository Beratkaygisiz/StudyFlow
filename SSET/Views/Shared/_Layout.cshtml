<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SSET</title>
    
    <!-- Bootstrap 5 CSS (Responsive Grid ve Hazır Bileşenler) -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    
    <!-- Bootstrap Icons (İkonlar) -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    
    <!-- Özel CSS (Düz beyaz ekran olmaması için arka plan ve kart stilleri) -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <!-- ================================================================== -->
    <!-- ÜST MENÜ (NAVBAR) - Responsive / Mobil Uyumlu Hamburger Menü       -->
    <!-- ================================================================== -->
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-primary shadow-sm">
            <div class="container">
                <!-- Proje Başlığı / Logo -->
                <a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-mortarboard-fill me-1"></i> SSET
                </a>

                <!-- Mobilde Açılan Menü Butonu (Responsive Toggler) -->
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navMenu">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <!-- 3 Controller'a Bağlantı Veren Menü Linkleri -->
                <div class="collapse navbar-collapse" id="navMenu">
                    <ul class="navbar-nav ms-auto mb-2 mb-lg-0">
                        <!-- Controller 1: Home -->
                        <li class="nav-item">
                            <a class="nav-link text-white" asp-controller="Home" asp-action="Index">
                                <i class="bi bi-house-door me-1"></i> Ana Sayfa
                            </a>
                        </li>
                        <!-- Controller 2: Exam -->
                        <li class="nav-item">
                            <a class="nav-link text-white" asp-controller="Exam" asp-action="Index">
                                <i class="bi bi-journal-check me-1"></i> Sınav Takibi
                            </a>
                        </li>
                        <!-- Controller 3: StudyPlan -->
                        <li class="nav-item">
                            <a class="nav-link text-white" asp-controller="StudyPlan" asp-action="Index">
                                <i class="bi bi-calendar-check me-1"></i> Çalışma Planı
                            </a>
                        </li>
                        <!-- Home/About -->
                        <li class="nav-item">
                            <a class="nav-link text-white" asp-controller="Home" asp-action="About">
                                <i class="bi bi-info-circle me-1"></i> Hakkında
                            </a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <!-- ================================================================== -->
    <!-- ANA SAYFA İÇERİĞİ                                                  -->
    <!-- ================================================================== -->
    <div class="container py-4">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <!-- ================================================================== -->
    <!-- ALT BİLGİ (FOOTER)                                                 -->
    <!-- ================================================================== -->
    <footer class="footer text-center text-muted py-3 bg-white border-top">
        <div class="container">
            <span>&copy; @DateTime.Now.Year - SSET (Öğrenci Çalışma ve Sınav Takip Sistemi) - 1. Hafta Prototipi</span>
        </div>
    </footer>

    <!-- Bootstrap JavaScript -->
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
