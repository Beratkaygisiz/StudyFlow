@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "Home";
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "Index";
}
<!DOCTYPE html>
<html lang="tr" data-bs-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - OCSTS</title>

    <!-- Google Fonts: Plus Jakarta Sans -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />

    <!-- Bootstrap 5.3 CSS ve Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />

    <!-- OCSTS Modern Özel Stil Dosyası -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <!-- Sayfa yüklenirken tema titremesini (FOUC) önlemek için erken tema kontrolü -->
    <script>
        (function () {
            const savedTheme = localStorage.getItem('ocsts-theme') || 'light';
            document.documentElement.setAttribute('data-bs-theme', savedTheme);
        })();
    </script>
</head>
<body>
    <!-- MODERN ÜST MENÜ (NAVBAR) -->
    <header class="sticky-top">
        <nav class="navbar navbar-expand-lg ocsts-navbar">
            <div class="container">
                <a class="navbar-brand d-flex align-items-center gap-2 fw-bold text-decoration-none" asp-controller="Home" asp-action="Index">
                    <span class="ocsts-brand-logo">
                        <i class="bi bi-mortarboard-fill"></i>
                    </span>
                    <div class="lh-sm">
                        <span class="d-block fw-extrabold tracking-tight" style="color: var(--ocsts-text);">OCSTS</span>
                        <span class="d-none d-sm-block text-muted" style="font-size: 0.7rem; font-weight: 500;">Öğrenci Çalışma & Sınav Takip</span>
                    </div>
                </a>

                <button class="navbar-toggler border-0 shadow-none" type="button" data-bs-toggle="collapse" data-bs-target="#ocstsNavbar"
                        aria-controls="ocstsNavbar" aria-expanded="false" aria-label="Menüyü Aç">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="ocstsNavbar">
                    <ul class="navbar-nav mx-auto mb-2 mb-lg-0 gap-1 mt-2 mt-lg-0">
                        <li class="nav-item">
                            <a class="nav-link ocsts-nav-link @(currentController == "Home" && currentAction == "Index" ? "active" : "")"
                               asp-controller="Home" asp-action="Index">
                                <i class="bi bi-grid-1x2-fill me-1"></i>Ana Sayfa
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link ocsts-nav-link @(currentController == "Exam" ? "active" : "")"
                               asp-controller="Exam" asp-action="Index">
                                <i class="bi bi-calendar2-check-fill me-1"></i>Sınav Yönetimi
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link ocsts-nav-link @(currentController == "StudyPlan" ? "active" : "")"
                               asp-controller="StudyPlan" asp-action="Index">
                                <i class="bi bi-journal-Check me-1 bi-list-task"></i>Çalışma Planı
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link ocsts-nav-link @(currentController == "Home" && currentAction == "About" ? "active" : "")"
                               asp-controller="Home" asp-action="About">
                                <i class="bi bi-info-circle-fill me-1"></i>Hakkında
                            </a>
                        </li>
                    </ul>

                    <!-- Sağ Üst Hızlı Ekleme Linkleri ve Koyu/Açık Mod Butonu -->
                    <div class="d-flex align-items-center gap-2 pt-2 pt-lg-0">
                        <a asp-controller="Exam" asp-action="Create" class="btn btn-sm btn-ocsts-primary px-3 py-2">
                            <i class="bi bi-plus-lg me-1"></i>Sınav Ekle
                        </a>
                        <a asp-controller="StudyPlan" asp-action="Create" class="btn btn-sm btn-outline-secondary rounded-3 px-3 py-2 fw-semibold">
                            <i class="bi bi-plus-lg me-1"></i>Konu Ekle
                        </a>
                        <button id="themeToggleBtn" type="button" class="theme-toggle-btn ms-1" title="Koyu / Açık Mod Geçişi">
                            <i id="themeIcon" class="bi bi-moon-stars-fill"></i>
                        </button>
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <!-- SAYFA İÇERİĞİ -->
    <main class="container py-4">
        @RenderBody()
    </main>

    <!-- MODERN ALT BİLGİ (FOOTER) -->
    <footer class="ocsts-footer py-3 mt-auto">
        <div class="container d-flex flex-column flex-md-row justify-content-between align-items-center gap-2 small">
            <div>
                <strong style="color: var(--ocsts-text);">OCSTS</strong> — Öğrenci Çalışma ve Sınav Takip Sistemi &copy; @DateTime.Now.Year
            </div>
            <div class="d-flex flex-wrap gap-2 justify-content-center">
                <span class="badge ocsts-badge-soft-primary">ASP.NET Core MVC</span>
                <span class="badge bg-secondary-subtle text-secondary-emphasis">ViewComponent</span>
                <span class="badge bg-secondary-subtle text-secondary-emphasis">PartialView</span>
                <span class="badge bg-secondary-subtle text-secondary-emphasis">HtmlHelpers</span>
            </div>
        </div>
    </footer>

    <!-- Bootstrap 5 JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

    <!-- Açık / Koyu Mod Geçiş Scripti -->
    <script>
        (function () {
            const toggleBtn = document.getElementById('themeToggleBtn');
            const themeIcon = document.getElementById('themeIcon');

            function syncIcon(theme) {
                if (theme === 'dark') {
                    themeIcon.className = 'bi bi-sun-fill text-warning';
                } else {
                    themeIcon.className = 'bi bi-moon-stars-fill';
                }
            }

            syncIcon(document.documentElement.getAttribute('data-bs-theme') || 'light');

            toggleBtn.addEventListener('click', function () {
                const current = document.documentElement.getAttribute('data-bs-theme') || 'light';
                const next = current === 'dark' ? 'light' : 'dark';
                document.documentElement.setAttribute('data-bs-theme', next);
                localStorage.setItem('ocsts-theme', next);
                syncIcon(next);
            });
        })();
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
