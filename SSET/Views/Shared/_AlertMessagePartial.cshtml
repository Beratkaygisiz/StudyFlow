@* ============================================================================
   [KISIM 2 İSTERİ] - PARTIALVIEW TANIMI (_AlertMessagePartial.cshtml)
   ----------------------------------------------------------------------------
   Bir sayfada (Örn: /Exam/Create veya /StudyPlan/Create) HtmlHelpers ile girilen
   form verisi kaydedildikten sonra, yönlendirilen diğer sayfada (/Exam/Index,
   /StudyPlan/Index veya /Home/Index) kullanıcıya işlem geri bildirimi gösterir.
   ============================================================================ *@

@if (TempData["SuccessMessage"] is string message && !string.IsNullOrWhiteSpace(message))
{
    <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm d-flex align-items-center gap-3 mb-4" role="alert">
        <div class="fs-4 text-success d-flex align-items-center">
            <i class="bi bi-check2-circle"></i>
        </div>
        <div class="flex-grow-1">
            <div class="fw-semibold">İşlem Başarıyla Kaydedildi</div>
            <div class="small">@message</div>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Kapat"></button>
    </div>
}
