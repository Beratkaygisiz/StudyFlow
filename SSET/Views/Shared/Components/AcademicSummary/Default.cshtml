@model OCSTS.Models.AcademicSummaryViewModel

@* ============================================================================
   [KISIM 2 İSTERİ] - VIEWCOMPONENT GÖRÜNÜMÜ (Default.cshtml)
   ----------------------------------------------------------------------------
   Bu dosya AcademicSummaryViewComponent sınıfının ürettiği görünümdür.
   ASP.NET Core MVC kuralı gereği "Views/Shared/Components/AcademicSummary/Default.cshtml"
   konumunda bulunur.
   Gönderilen "Mode" parametresine göre çağrıldığı sayfaya en uygun kartları gösterir:
   - "full"    : Ana Sayfa (Home/Index) genel gösterge paneli
   - "exams"   : Sınav Takip (Exam/Index) üst bilgi özeti
   - "study"   : Çalışma Planı (StudyPlan/Index) ilerleme özeti
   - "compact" : Hakkında (Home/About) canlı sistem durumu kartı
   ============================================================================ *@

@if (Model.Mode == "compact")
{
    <div class="card ocsts-surface border-0 shadow-sm mb-4">
        <div class="card-body p-4">
            <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
                <div>
                    <span class="badge ocsts-badge-soft-primary mb-2">
                        <i class="bi bi-cpu me-1"></i>Canlı ViewComponent Verisi
                    </span>
                    <h5 class="fw-bold mb-1">Sistemdeki Güncel Akademik Durum</h5>
                    <p class="text-muted small mb-0">
                        Bu özet kutusu <code>AcademicSummaryViewComponent</code> tarafından anlık olarak hesaplanmaktadır.
                    </p>
                </div>
                <div class="d-flex flex-wrap gap-3">
                    <div class="ocsts-mini-stat">
                        <span class="ocsts-mini-stat-value text-primary">@Model.TotalExams</span>
                        <span class="ocsts-mini-stat-label">Kayıtlı Sınav</span>
                    </div>
                    <div class="ocsts-mini-stat">
                        <span class="ocsts-mini-stat-value text-success">@Model.CompletedTopics / @Model.TotalTopics</span>
                        <span class="ocsts-mini-stat-label">Tamamlanan Konu</span>
                    </div>
                    <div class="ocsts-mini-stat">
                        <span class="ocsts-mini-stat-value text-info">%@Model.CompletionPercentage</span>
                        <span class="ocsts-mini-stat-label">Çalışma İlerlemesi</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
else if (Model.Mode == "exams")
{
    <div class="row g-3 mb-4">
        <div class="col-sm-6 col-xl-3">
            <div class="card ocsts-stat-card border-0 shadow-sm h-100">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="ocsts-icon-box bg-primary bg-opacity-10 text-primary">
                        <i class="bi bi-journal-bookmark-fill"></i>
                    </div>
                    <div>
                        <div class="text-muted small fw-medium">Toplam Sınav</div>
                        <div class="fs-4 fw-bold">@Model.TotalExams</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="card ocsts-stat-card border-0 shadow-sm h-100">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="ocsts-icon-box bg-info bg-opacity-10 text-info">
                        <i class="bi bi-calendar-event-fill"></i>
                    </div>
                    <div>
                        <div class="text-muted small fw-medium">Yaklaşan Sınav</div>
                        <div class="fs-4 fw-bold">@Model.UpcomingExamsCount</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="card ocsts-stat-card border-0 shadow-sm h-100">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="ocsts-icon-box bg-warning bg-opacity-10 text-warning">
                        <i class="bi bi-hourglass-split"></i>
                    </div>
                    <div>
                        <div class="text-muted small fw-medium">Not Girişi Bekleyen</div>
                        <div class="fs-4 fw-bold">@Model.PendingScoreExamsCount</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="card ocsts-stat-card border-0 shadow-sm h-100">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="ocsts-icon-box bg-success bg-opacity-10 text-success">
                        <i class="bi bi-bullseye"></i>
                    </div>
                    <div>
                        <div class="text-muted small fw-medium">Ortalama Hedef Not</div>
                        <div class="fs-4 fw-bold">
                            @Model.AverageTargetScore
                            @if (Model.AverageActualScore.HasValue)
                            {
                                <span class="fs-6 fw-normal text-success ms-1">(Alınan: @Model.AverageActualScore)</span>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
else if (Model.Mode == "study")
{
    <div class="row g-3 mb-4">
        <div class="col-sm-6 col-lg-4">
            <div class="card ocsts-stat-card border-0 shadow-sm h-100">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="ocsts-icon-box bg-success bg-opacity-10 text-success">
                        <i class="bi bi-check2-circle"></i>
                    </div>
                    <div>
                        <div class="text-muted small fw-medium">Tamamlanan Konular</div>
                        <div class="fs-4 fw-bold">@Model.CompletedTopics <span class="fs-6 fw-normal text-muted">/ @Model.TotalTopics konu</span></div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-lg-4">
            <div class="card ocsts-stat-card border-0 shadow-sm h-100">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="ocsts-icon-box bg-primary bg-opacity-10 text-primary">
                        <i class="bi bi-clock-history"></i>
                    </div>
                    <div>
                        <div class="text-muted small fw-medium">Toplam Çalışma Süresi</div>
                        <div class="fs-4 fw-bold">@Model.TotalCompletedHours <span class="fs-6 fw-normal text-muted">/ @Model.TotalPlannedHours saat</span></div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-lg-4">
            <div class="card ocsts-stat-card border-0 shadow-sm h-100">
                <div class="card-body d-flex flex-column justify-content-center">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="text-muted small fw-medium">Genel Hedef İlerlemesi</span>
                        <span class="badge bg-success-subtle text-success-emphasis fw-semibold">%@Model.CompletionPercentage</span>
                    </div>
                    <div class="progress ocsts-progress" role="progressbar" aria-valuenow="@Model.CompletionPercentage" aria-valuemin="0" aria-valuemax="100">
                        <div class="progress-bar bg-success" style="width: @Model.CompletionPercentage%"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
else
{
    @* mode == "full" (Ana Sayfa Gösterge Paneli) *@
    <div class="row g-3 mb-4">
        <div class="col-sm-6 col-xl-3">
            <div class="card ocsts-stat-card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <div class="ocsts-icon-box bg-primary bg-opacity-10 text-primary">
                            <i class="bi bi-calendar2-week-fill"></i>
                        </div>
                        <span class="badge ocsts-badge-soft-primary">@Model.UpcomingExamsCount Yaklaşan</span>
                    </div>
                    <div class="text-muted small fw-medium">Kayıtlı Sınavlar</div>
                    <div class="fs-3 fw-bold mb-1">@Model.TotalExams</div>
                    <div class="small text-muted text-truncate">
                        @if (Model.NextUpcomingExam != null)
                        {
                            var daysLeft = Math.Max(0, (Model.NextUpcomingExam.ExamDate.Date - DateTime.Now.Date).Days);
                            <span><i class="bi bi-lightning-charge-fill text-warning me-1"></i>Sıradaki: <strong>@Model.NextUpcomingExam.CourseName</strong> (@daysLeft gün)</span>
                        }
                        else
                        {
                            <span>Yaklaşan sınav bulunmuyor</span>
                        }
                    </div>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-xl-3">
            <div class="card ocsts-stat-card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <div class="ocsts-icon-box bg-warning bg-opacity-10 text-warning">
                            <i class="bi bi-trophy-fill"></i>
                        </div>
                        @if (Model.PendingScoreExamsCount > 0)
                        {
                            <span class="badge bg-warning-subtle text-warning-emphasis">@Model.PendingScoreExamsCount Not Bekliyor</span>
                        }
                        else
                        {
                            <span class="badge bg-success-subtle text-success-emphasis">Güncel</span>
                        }
                    </div>
                    <div class="text-muted small fw-medium">Hedef Not Ortalaması</div>
                    <div class="fs-3 fw-bold mb-1">@Model.AverageTargetScore</div>
                    <div class="small text-muted">
                        @if (Model.AverageActualScore.HasValue)
                        {
                            <span>Gerçekleşen Not Ort.: <strong class="text-success">@Model.AverageActualScore</strong></span>
                        }
                        else
                        {
                            <span>Henüz sınav notu girilmedi</span>
                        }
                    </div>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-xl-3">
            <div class="card ocsts-stat-card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <div class="ocsts-icon-box bg-success bg-opacity-10 text-success">
                            <i class="bi bi-list-check"></i>
                        </div>
                        <span class="badge bg-success-subtle text-success-emphasis">@Model.RemainingTopics Bekleyen</span>
                    </div>
                    <div class="text-muted small fw-medium">Tamamlanan Konu</div>
                    <div class="fs-3 fw-bold mb-1">@Model.CompletedTopics <span class="fs-6 fw-normal text-muted">/ @Model.TotalTopics</span></div>
                    <div class="small text-muted">
                        Düzenli konu takibi ile görünürlük sağlar
                    </div>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-xl-3">
            <div class="card ocsts-stat-card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <div class="ocsts-icon-box bg-info bg-opacity-10 text-info">
                            <i class="bi bi-stopwatch-fill"></i>
                        </div>
                        <span class="badge bg-info-subtle text-info-emphasis">%@Model.CompletionPercentage Tamamlandı</span>
                    </div>
                    <div class="text-muted small fw-medium">Çalışma Süresi</div>
                    <div class="fs-3 fw-bold mb-2">@Model.TotalCompletedHours <span class="fs-6 fw-normal text-muted">/ @Model.TotalPlannedHours sa</span></div>
                    <div class="progress ocsts-progress" role="progressbar" aria-valuenow="@Model.CompletionPercentage" aria-valuemin="0" aria-valuemax="100">
                        <div class="progress-bar bg-info" style="width: @Model.CompletionPercentage%"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
